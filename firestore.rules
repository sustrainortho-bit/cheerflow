rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 認証なしのリンク共有モデル：URLの projectId (Firestoreのドキュメント自動採番ID、
    // 事実上推測不可能な文字列) を知っている人は誰でも読み書きできる。
    // Googleドキュメントの「リンクを知っている全員が編集可」と同じセキュリティモデル。
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['state', 'updatedAt']);
    }

    // 閲覧専用の共有リンク（?rv=<id>）用のスナップショット。
    // 誰でも作成・閲覧できるが、一度作成したら二度と書き換え・削除はできない
    // （URLに直接埋め込む代わりに短いIDで参照するだけで、意味的には「閲覧専用」を維持する）。
    match /viewSnapshots/{snapshotId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['state', 'createdAt']);
      allow update, delete: if false;
    }
  }
}
